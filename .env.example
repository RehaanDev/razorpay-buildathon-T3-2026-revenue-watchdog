# ─────────────────────────────────────────────────────────────────────────────
# Revenue Watchdog — environment variables
#
# Copy this file to .env and fill in your keys.
# Never commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent (Gemini) ───────────────────────────────────────────────────────────

# Get from https://aistudio.google.com/apikey
# New keys are "auth keys" and start with "AQ." — that format is correct and works.
# Older "standard" keys start with "AIza" and also work if restricted to the Gemini API.
GEMINI_API_KEY=

# Leave GEMINI_MODEL blank to auto-select the best model your key can access.
# Or pin one explicitly. Recommended: gemini-flash-latest (alias, never goes stale).
# Current models: gemini-flash-latest, gemini-3.7-flash, gemini-3.5-flash
# GEMINI_MODEL=gemini-flash-latest

AGENT_DRIVER=gemini

# ── Razorpay (test mode only — never use live keys here) ─────────────────────

# RAZORPAY_MODE=live        ← uncomment to use real Razorpay test-mode calls
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set this to the secret shown in the Razorpay dashboard webhook settings.
# RAZORPAY_WEBHOOK_SECRET=

# ── Tunnel (needed for webhooks when running locally) ─────────────────────────

# After running:  npx cloudflared tunnel --url http://localhost:4000
# paste the https://…trycloudflare.com URL here so payment links work.
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ── Optional ─────────────────────────────────────────────────────────────────

# PORT=4000
# SYNTHETIC_TRAFFIC=on     ← set to "off" for real-payments-only mode
# ASSUMED_BASELINE_RATE=0.92
